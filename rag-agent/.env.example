# Postgres
DATABASE_URL=postgresql://rag_user:CHANGE_ME@postgres:5432/rag_db

# Redis (broker da fila de workers)
REDIS_URL=redis://redis:6379/0

# OpenRouter
OPENROUTER_API_KEY=CHANGE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Autenticação da API (usada pelo uploader local)
API_AUTH_TOKEN=CHANGE_ME

# VPN kill switch
VPN_CHECK_INTERVAL_SECONDS=30
VPN_EXPECTED_IP=CHANGE_ME
VPN_IP_CHECK_URL=https://api.ipify.org

# Modelo de embedding
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# Reranker
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# WireGuard / Gluetun (ProtonVPN)
WIREGUARD_PRIVATE_KEY=CHANGE_ME
WIREGUARD_ADDRESSES=CHANGE_ME
VPN_SERVICE_PROVIDER=protonvpn
